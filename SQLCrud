## 5. Page 1 — `Default.aspx.cs`

Right-click `Default.aspx`, select View Code, and add the following code.

```

using System;
using System.Configuration;
using System.Data.SqlClient;

namespace StudentCRUD
{
    public partial class Default : System.Web.UI.Page
    {
        string cs = ConfigurationManager
            .ConnectionStrings["con"].ConnectionString;

        protected void btnAdd_Click(object sender, EventArgs e)
        {
            using (SqlConnection con = new SqlConnection(cs))
            {
                string q = "INSERT INTO Student VALUES (@ID,@Name,@Dept)";

                SqlCommand cmd = new SqlCommand(q, con);
                cmd.Parameters.AddWithValue("@ID", txtID.Text);
                cmd.Parameters.AddWithValue("@Name", txtName.Text);
                cmd.Parameters.AddWithValue("@Dept", txtDept.Text);

                con.Open();
                cmd.ExecuteNonQuery();
            }

            lblMsg.Text = "Record Added Successfully!";
        }

        protected void btnUpdate_Click(object sender, EventArgs e)
        {
            using (SqlConnection con = new SqlConnection(cs))
            {
                string q = "UPDATE Student SET Name=@Name, Department=@Dept WHERE ID=@ID";

                SqlCommand cmd = new SqlCommand(q, con);
                cmd.Parameters.AddWithValue("@ID", txtID.Text);
                cmd.Parameters.AddWithValue("@Name", txtName.Text);
                cmd.Parameters.AddWithValue("@Dept", txtDept.Text);

                con.Open();
                int n = cmd.ExecuteNonQuery();

                lblMsg.Text = n > 0 ? "Record Updated!" : "ID Not Found!";
            }
        }

        protected void btnDelete_Click(object sender, EventArgs e)
        {
            using (SqlConnection con = new SqlConnection(cs))
            {
                string q = "DELETE FROM Student WHERE ID=@ID";

                SqlCommand cmd = new SqlCommand(q, con);
                cmd.Parameters.AddWithValue("@ID", txtID.Text);

                con.Open();
                int n = cmd.ExecuteNonQuery();

                lblMsg.Text = n > 0 ? "Record Deleted!" : "ID Not Found!";
            }
        }

        protected void btnView_Click(object sender, EventArgs e)
        {
            Response.Redirect("Display.aspx");
        }
    }
}

```

## 6. Page 2 — `Display.aspx`

This is the output page. The GridView displays all records and provides Edit and Delete buttons.

```

<%@ Page Language="C#" AutoEventWireup="true"
    CodeBehind="Display.aspx.cs"
