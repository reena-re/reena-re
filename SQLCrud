## 2. `Default.aspx.cs` — CRUD code

```
using System;
using System.Configuration;
using System.Data.SqlClient;

namespace StudentCRUD
{
    public partial class Default : System.Web.UI.Page
    {
        string cs = ConfigurationManager
            .ConnectionStrings["con"].ConnectionString;

        protected void Add(object sender, EventArgs e)
        {
            using (SqlConnection con = new SqlConnection(cs))
            {
                string q = "INSERT INTO Student (ID, Name, Department) " +
                           "VALUES (@ID, @Name, @Dept)";

                SqlCommand cmd = new SqlCommand(q, con);
                cmd.Parameters.AddWithValue("@ID", int.Parse(t1.Text));
                cmd.Parameters.AddWithValue("@Name", t2.Text);
                cmd.Parameters.AddWithValue("@Dept", t3.Text);

                con.Open();
                cmd.ExecuteNonQuery();
            }

            lblMsg.Text = "Record Added!";
        }

        protected void Update(object sender, EventArgs e)
        {
            using (SqlConnection con = new SqlConnection(cs))
            {
                string q = "UPDATE Student SET Name=@Name, " +
                           "Department=@Dept WHERE ID=@ID";

                SqlCommand cmd = new SqlCommand(q, con);
                cmd.Parameters.AddWithValue("@ID", int.Parse(t1.Text));
                cmd.Parameters.AddWithValue("@Name", t2.Text);
                cmd.Parameters.AddWithValue("@Dept", t3.Text);

                con.Open();
                int n = cmd.ExecuteNonQuery();

                lblMsg.Text = n > 0 ? "Record Updated!" : "ID Not Found!";
            }
        }

        protected void Delete(object sender, EventArgs e)
        {
            using (SqlConnection con = new SqlConnection(cs))
            {
                string q = "DELETE FROM Student WHERE ID=@ID";

                SqlCommand cmd = new SqlCommand(q, con);
                cmd.Parameters.AddWithValue("@ID", int.Parse(t1.Text));

                con.Open();
                int n = cmd.ExecuteNonQuery();

                lblMsg.Text = n > 0 ? "Record Deleted!" : "ID Not Found!";
            }
        }

        protected void View(object sender, EventArgs e)
        {
            Response.Redirect("Display.aspx");
        }
    }
}
```

