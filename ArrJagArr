# Part 1: One-Dimensional Arrays — 5 Programs

## 1. Student Marks and Total

Question: Write a C# program to read marks of students and calculate the total.

```
using System;

class Program
{
    static void Main()
    {
        Console.Write("Enter number of subjects: ");
        int n = Convert.ToInt32(Console.ReadLine());

        int[] marks = new int[n];
        int total = 0;

        for (int i = 0; i < n; i++)
        {
            Console.Write("Enter marks: ");
            marks[i] = Convert.ToInt32(Console.ReadLine());
            total += marks[i];
        }

        Console.WriteLine("Total Marks = " + total);
        Console.ReadLine();
    }
}
```

## 2. Find Highest Mark

Question: Write a program to find the highest mark in an array.

```
using System;

class Program
{
    static void Main()
    {
        Console.Write("Enter number of students: ");
        int n = Convert.ToInt32(Console.ReadLine());

        if (n <= 0)
        {
            Console.WriteLine("Invalid size");
            Console.ReadLine();
            return;
        }

        int[] marks = new int[n];

        for (int i = 0; i < n; i++)
        {
            Console.Write("Enter mark: ");
            marks[i] = Convert.ToInt32(Console.ReadLine());
        }

        int max = marks[0];

        for (int i = 1; i < n; i++)
        {
            if (marks[i] > max)
                max = marks[i];
        }

        Console.WriteLine("Highest Mark = " + max);
        Console.ReadLine();
    }
}
```

## 3. Find Average Marks

