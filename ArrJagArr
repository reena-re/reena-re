## 3. Find Highest Mark of Each Student

Question: Write a jagged array program to find the highest mark of each student.

```
using System;

class Program
{
    static void Main()
    {
        Console.Write("Enter number of students: ");
        int n = Convert.ToInt32(Console.ReadLine());

        int[][] marks = new int[n][];

        for (int i = 0; i < n; i++)
        {
            Console.Write("Enter number of subjects: ");
            int m = Convert.ToInt32(Console.ReadLine());

            marks[i] = new int[m];

            for (int j = 0; j < m; j++)
                marks[i][j] = Convert.ToInt32(Console.ReadLine());
        }

        for (int i = 0; i < n; i++)
        {
            if (marks[i].Length == 0)
            {
                Console.WriteLine("Student " + (i + 1) + ": No marks");
                continue;
            }

            int max = marks[i][0];

            for (int j = 1; j < marks[i].Length; j++)
            {
                if (marks[i][j] > max)
                    max = marks[i][j];
            }

            Console.WriteLine("Student " + (i + 1) +
                              " Highest Mark = " + max);
        }

        Console.ReadLine();
    }
}
```

## 4. Store Different Numbers for Different Groups

Question: Write a program to store numbers in groups using a jagged array and display them.

```
using System;

class Program
{
    static void Main()
    {
        Console.Write("Enter number of groups: ");
        int n = Convert.ToInt32(Console.ReadLine());

        int[][] a = new int[n][];

        for (int i = 0; i < n; i++)
        {
            Console.Write("Enter elements in group " + (i + 1) + ": ");
            int m = Convert.ToInt32(Console.ReadLine());

            a[i] = new int[m];

            for (int j = 0; j < m; j++)
                a[i][j] = Convert.ToInt32(Console.ReadLine());
        }

        Console.WriteLine("Jagged Array:");

        for (int i = 0; i < n; i++)
        {
            for (int j = 0; j < a[i].Length; j++)
                Console.Write(a[i][j] + " ");

            Console.WriteLine();
        }

        Console.ReadLine();
    }
}
```

## 5. Average Marks of Each Student

Question: Write a program to calculate the average marks of each student using a jagged array.

```
using System;

class Program
{
    static void Main()
    {
        Console.Write("Enter number of students: ");
        int n = Convert.ToInt32(Console.ReadLine());

        int[][] marks = new int[n][];

        for (int i = 0; i < n; i++)
        {
            Console.Write("Enter number of subjects: ");
            int m = Convert.ToInt32(Console.ReadLine());

            marks[i] = new int[m];

            for (int j = 0; j < m; j++)
                marks[i][j] = Convert.ToInt32(Console.ReadLine());
        }

        for (int i = 0; i < n; i++)
        {
            if (marks[i].Length == 0)
            {
                Console.WriteLine("Student " + (i + 1) + ": No marks");
                continue;
            }

            int total = 0;

            for (int j = 0; j < marks[i].Length; j++)
                total += marks[i][j];

            double average = (double)total / marks[i].Length;

            Console.WriteLine("Student " + (i + 1) +
                              " Average = " + average);
        }

        Console.ReadLine();
    }
}
```

## Important exam differences

| Normal array                                                        | Jagged array                                 |
| ------------------------------------------------------------------- | -------------------------------------------- |
| Stores elements of one dimension or a fixed rectangular structure   | Stores an array of arrays                    |
| Example: `int[] a = new int[5];`                                    | Example: `int[][] a = new int[3][];`         |
| Access using `a[i]`                                                 | Access using `a[i][j]`                       |
| A two-dimensional rectangular array has equal column counts per row | Each inner array can have a different length |

Easy trick to remember, bro:

- `int[]` → one-dimensional array
- `int[,]` → rectangular two-dimensional array
- `int[][]` → jagged array

