## 11. Check palindrome number using `while`

```
using System;

class Program
{
    static void Main()
    {
        Console.Write("Enter number: ");
        int n = int.Parse(Console.ReadLine());

        long temp = Math.Abs((long)n);
        long original = temp, rev = 0;

        while (temp > 0)
        {
            rev = rev * 10 + temp % 10;
            temp /= 10;
        }

        if (n >= 0 && original == rev)
            Console.WriteLine("Palindrome");
        else
            Console.WriteLine("Not Palindrome");

        Console.ReadLine();
    }
}
```

