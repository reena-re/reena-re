Definition: Method overloading means creating multiple methods with the same name but different parameters in the same class.

# 1. Add Numbers Using Method Overloading

Question: Write a C# program to overload the `Add()` method to add two and three numbers.

```
using System;

class Program
{
    void Add(int a, int b)
    {
        Console.WriteLine("Sum = " + (a + b));
    }

    void Add(int a, int b, int c)
    {
        Console.WriteLine("Sum = " + (a + b + c));
    }

    static void Main()
    {
        Program p = new Program();

        Console.Write("Enter two numbers: ");
        int a = Convert.ToInt32(Console.ReadLine());
        int b = Convert.ToInt32(Console.ReadLine());

        p.Add(a, b);

        Console.Write("Enter third number: ");
        int c = Convert.ToInt32(Console.ReadLine());

        p.Add(a, b, c);

        Console.ReadLine();
    }
}
```

# 2. Student Marks Using Method Overloading

Question: Write a program to calculate total marks for two subjects and three subjects using method overloading.

```
using System;

class Student
{
    public void Total(int a, int b)
    {
        Console.WriteLine("Total = " + (a + b));
    }

    public void Total(int a, int b, int c)
    {
        Console.WriteLine("Total = " + (a + b + c));
    }
}

class Program
{
    static void Main()
    {
        Student s = new Student();

        Console.Write("Enter two subject marks: ");
        int a = Convert.ToInt32(Console.ReadLine());
        int b = Convert.ToInt32(Console.ReadLine());

        s.Total(a, b);

        Console.Write("Enter third subject mark: ");
        int c = Convert.ToInt32(Console.ReadLine());

        s.Total(a, b, c);

        Console.ReadLine();
    }
}
```

# 3. Student Details Using Method Overloading

Question: Write a program to display student details using overloaded `Display()` methods.

```
using System;

class Student
{
    public void Display(string name)
    {
        Console.WriteLine("Name: " + name);
    }

    public void Display(string name, int id)
    {
        Console.WriteLine("Name: " + name);
        Console.WriteLine("ID: " + id);
    }

    public void Display(string name, int id, string dept)
    {
        Console.WriteLine("Name: " + name);
        Console.WriteLine("ID: " + id);
        Console.WriteLine("Department: " + dept);
    }
}

class Program
{
    static void Main()
    {
        Student s = new Student();

        Console.Write("Enter name: ");
        string name = Console.ReadLine();

        Console.Write("Enter ID: ");
        int id = Convert.ToInt32(Console.ReadLine());

        Console.Write("Enter department: ");
        string dept = Console.ReadLine();

        s.Display(name);
        Console.WriteLine();

        s.Display(name, id);
        Console.WriteLine();

        s.Display(name, id, dept);

        Console.ReadLine();
    }
}
```

# 4. Area Calculation Using Method Overloading

Question: Write a program to calculate the area of a square and rectangle using method overloading.

```
using System;

class Area
{
    public void Calculate(int side)
    {
        Console.WriteLine("Square Area = " + (side * side));
    }

    public void Calculate(int length, int breadth)
    {
        Console.WriteLine("Rectangle Area = " + (length * breadth));
    }
}

class Program
{
    static void Main()
    {
        Area a = new Area();

        Console.Write("Enter square side: ");
        int side = Convert.ToInt32(Console.ReadLine());

        a.Calculate(side);

        Console.Write("Enter rectangle length: ");
        int l = Convert.ToInt32(Console.ReadLine());

        Console.Write("Enter rectangle breadth: ");
        int b = Convert.ToInt32(Console.ReadLine());

        a.Calculate(l, b);

        Console.ReadLine();
    }
}
```

# 5. Employee Salary Using Method Overloading

Question: Write a program to calculate monthly and annual salary using method overloading.

```
using System;

class Employee
{
    public void Salary(double monthly)
    {
        Console.WriteLine("Monthly Salary = " + monthly);
    }

    public void Salary(double monthly, int months)
    {
        Console.WriteLine("Total Salary = " + (monthly * months));
    }
}

class Program
{
    static void Main()
    {
        Employee e = new Employee();

        Console.Write("Enter monthly salary: ");
        double salary = Convert.ToDouble(Console.ReadLine());

        Console.Write("Enter number of months: ");
        int months = Convert.ToInt32(Console.ReadLine());

        e.Salary(salary);
        e.Salary(salary, months);

        Console.ReadLine();
    }
}
```

## Quick exam revision

| Method overloading rule                           | Example                                                           |
| ------------------------------------------------- | ----------------------------------------------------------------- |
| Same method name, different parameter count       | `Add(int a, int b)` and `Add(int a, int b, int c)`                |
| Same method name, different parameter types       | `Display(int id)` and `Display(string name)`                      |
| Same method name, different parameter order/types | `Show(int id, string name)` and `Show(string name, int id)`       |
| Only changing the return type is not enough       | Two `int Add()` methods differing only by return type are invalid |

