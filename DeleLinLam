# 4. Student Grade Using Delegate

Question: Write a program to display a student's grade based on marks using a delegate.

```
using System;

delegate string GradeDelegate(int marks);

class Student
{
    public string Grade(int marks)
    {
        if (marks >= 90)
            return "A Grade";
        else if (marks >= 75)
            return "B Grade";
        else if (marks >= 50)
            return "C Grade";
        else
            return "Fail";
    }
}

class Program
{
    static void Main()
    {
        Console.Write("Enter Student Name: ");
        string name = Console.ReadLine();

        Console.Write("Enter Marks: ");
        int marks = Convert.ToInt32(Console.ReadLine());

        Student s = new Student();

        GradeDelegate d = s.Grade;

        Console.WriteLine("Student: " + name);
        Console.WriteLine("Grade: " + d(marks));

        Console.ReadLine();
    }
}
```

# 5. Student Fee Calculation Using Delegate

Question: Write a program to calculate the remaining college fee using a delegate.

```
using System;

delegate double FeeDelegate(double total, double paid);

class Student
{
    public double Balance(double total, double paid)
    {
        return total - paid;
    }
}

class Program
{
    static void Main()
    {
        Console.Write("Enter Student Name: ");
        string name = Console.ReadLine();

        Console.Write("Enter Total Fee: ");
        double total = Convert.ToDouble(Console.ReadLine());

        Console.Write("Enter Fee Already Paid: ");
        double paid = Convert.ToDouble(Console.ReadLine());

        Student s = new Student();

        FeeDelegate d = s.Balance;

        Console.WriteLine("Student: " + name);
        Console.WriteLine("Remaining Fee: " + d(total, paid));

        Console.ReadLine();
    }
}
```



