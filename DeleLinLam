# 1. Student Details Using Delegate

Question: Write a C# program to display student details using a delegate.

```
using System;

delegate void StudentDelegate();

class Student
{
    public void Display()
    {
        Console.Write("Enter Student ID: ");
        string id = Console.ReadLine();

        Console.Write("Enter Student Name: ");
        string name = Console.ReadLine();

        Console.Write("Enter Department: ");
        string dept = Console.ReadLine();

        Console.WriteLine("\nStudent Details");
        Console.WriteLine("ID: " + id);
        Console.WriteLine("Name: " + name);
        Console.WriteLine("Department: " + dept);
    }
}

class Program
{
    static void Main()
    {
        Student s = new Student();

        StudentDelegate d = s.Display;
        d();

        Console.ReadLine();
    }
}
```

Concept: The delegate calls the `Display()` method of the `Student` class.

# 2. Student Marks and Result Using Delegate

Question: Write a program to calculate total marks and display the result using a delegate.

```
using System;

delegate int MarksDelegate(int a, int b, int c);

class Student
{
    public int Total(int a, int b, int c)
    {
        return a + b + c;
    }
}

class Program
{
    static void Main()
    {
        Console.Write("Enter Student Name: ");
        string name = Console.ReadLine();

        Console.Write("Enter three subject marks: ");
        int a = Convert.ToInt32(Console.ReadLine());
        int b = Convert.ToInt32(Console.ReadLine());
        int c = Convert.ToInt32(Console.ReadLine());

        Student s = new Student();

        MarksDelegate d = s.Total;
        int total = d(a, b, c);

        Console.WriteLine("Student: " + name);
        Console.WriteLine("Total Marks: " + total);
        Console.WriteLine("Average: " + total / 3.0);

        Console.ReadLine();
    }
}
```

# 3. Employee Salary Using Delegate

