# C# String Manipulation — 15 Programs

## 1. Reverse a String

```
using System;

class Program
{
    static void Main()
    {
        Console.Write("Enter string: ");
        string s = Console.ReadLine();
        string rev = "";

        for (int i = s.Length - 1; i >= 0; i--)
            rev += s[i];

        Console.WriteLine("Reverse = " + rev);
        Console.ReadLine();
    }
}
```

## 2. Check Palindrome String

```
using System;

class Program
{
    static void Main()
    {
        Console.Write("Enter string: ");
        string s = Console.ReadLine().ToLower();
        string rev = "";

        for (int i = s.Length - 1; i >= 0; i--)
            rev += s[i];

        Console.WriteLine(s == rev ? "Palindrome" : "Not Palindrome");
        Console.ReadLine();
    }
}
```

## 3. Count Vowels and Consonants

```
using System;

class Program
{
    static void Main()
    {
        Console.Write("Enter string: ");
        string s = Console.ReadLine().ToLower();
        int v = 0, c = 0;

        foreach (char ch in s)
        {
            if (ch >= 'a' && ch <= 'z')
            {
                if ("aeiou".IndexOf(ch) >= 0)
                    v++;
                else
                    c++;
            }
        }

        Console.WriteLine("Vowels = " + v);
        Console.WriteLine("Consonants = " + c);
        Console.ReadLine();
    }
}
```

