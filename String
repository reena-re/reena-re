## 14. Check Whether Two Strings Are Anagrams

Example: `listen` and `silent`.

```
using System;

class Program
{
    static void Main()
    {
        Console.Write("Enter first string: ");
        string a = Console.ReadLine().Replace(" ", "").ToLower();

        Console.Write("Enter second string: ");
        string b = Console.ReadLine().Replace(" ", "").ToLower();

        char[] x = a.ToCharArray();
        char[] y = b.ToCharArray();

        Array.Sort(x);
        Array.Sort(y);

        if (new string(x) == new string(y))
            Console.WriteLine("Anagrams");
        else
            Console.WriteLine("Not Anagrams");

        Console.ReadLine();
    }
}
```

## 15. Reverse Each Word in a Sentence

Example: `Hello World` → `olleH dlroW`

```
using System;

class Program
{
    static void Main()
    {
        Console.Write("Enter sentence: ");
        string s = Console.ReadLine();

        string[] words = s.Split(' ');

        for (int i = 0; i < words.Length; i++)
        {
            char[] ch = words[i].ToCharArray();
            Array.Reverse(ch);
            words[i] = new string(ch);
        }

        Console.WriteLine(string.Join(" ", words));
        Console.ReadLine();
    }
}
```

